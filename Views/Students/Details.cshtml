@model StudentManagementMVC.Models.Student
@{ViewData["Title"]="Chi tiết sinh viên";}<h1>Chi tiết sinh viên</h1><hr><dl class="row"><dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.StudentCode</dd><dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.FullName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@Model.Gender</dd><dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Chuyên ngành</dt><dd class="col-sm-9">@Model.Major</dd><dt class="col-sm-3">GPA</dt><dd class="col-sm-9">@Model.GPA.ToString("0.00")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại</a>